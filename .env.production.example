# Runtime environment variables for the `app` container (docker-compose `env_file`).
# Copy to `.env.production` on the server and fill in real values. Never commit the real file.
#
# Staging checkout: copy this same template to `.env.staging` instead, with
# SITE_URL pointing at the staging domain. See DEPLOYMENT.md "Staging environment".

SITE_URL=https://www.schlosseyrichshof.de

# Wix Contacts API — Wix dashboard > Settings > API Keys (needs Contacts read/write)
WIX_API_KEY=
WIX_SITE_ID=
WIX_NEWSLETTER_LABEL_ID="NL anfordern"

# Secret used to sign newsletter double opt-in confirmation links.
NEWSLETTER_TOKEN_SECRET=

# Resend — sends contact-form emails to the responsible team member.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Schloss Eyrichshof <kontakt@schlosseyrichshof.de>"
