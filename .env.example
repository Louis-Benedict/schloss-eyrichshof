# docker-compose variables — used for Traefik routing/TLS and as Docker build args.
# Copy to `.env` on the server (docker compose loads it automatically) and fill in real values.
#
# Production checkout (docker-compose.yml): fill in DOMAIN and ACME_EMAIL.
# Staging checkout (docker-compose.staging.yml): fill in STAGING_DOMAIN instead —
# DOMAIN/ACME_EMAIL aren't used there since staging has no Traefik of its own.
# See DEPLOYMENT.md "Staging environment".

# Domain Traefik requests the Let's Encrypt certificate for and routes to the app.
DOMAIN=schlosseyrichshof.de

# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=

# Staging checkout only — domain the staging app is reachable at.
STAGING_DOMAIN=staging.schlosseyrichshof.de

# --- Build args (baked into the client bundle at image build time) ---
NEXT_PUBLIC_SHOP_URL=https://www.shop.schlosseyrichshof.de/shop
NEXT_PUBLIC_GTM_ID=
